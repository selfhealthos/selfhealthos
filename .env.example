# Copy to .env and edit. Never commit .env.
#
#   quick start (this machine): keep the defaults below, just set a real
#     DJANGO_SECRET_KEY and POSTGRES_PASSWORD.
#   real deployment (LAN/server/public): see the "if you're deploying" notes
#     on each line below.

# --- Compose --------------------------------------------------------------
# Layers the dev overlay (hot reload, bind-mounted source) on top of the base
# stack. Delete both lines for a production-style deploy so only compose.yaml
# applies.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
COMPOSE_PATH_SEPARATOR=:

# Already running a reverse proxy (Caddy, Traefik, nginx-proxy)? Swap the dev
# overlay for compose.proxy.yaml instead, and name the network your proxy
# already uses. That puts `next` on it so the proxy can reach the container
# directly, and you can then bind HTTP_PORT to loopback or drop it entirely.
#
#   COMPOSE_FILE=compose.yaml:compose.proxy.yaml
#   INGRESS_NETWORK=my-ingress-net
#
# Point the proxy at container `selfhealthos-next-1` port 3000 - the container
# name, not the service name `next`, which other projects use too.

# No proxy of your own, but you want HTTPS anyway - a phone on the LAN posting
# a bearer token, say? Add compose.tls.yaml. Neither selfhealthos image can
# serve TLS (`next` and django both speak plain HTTP), so this adds one small
# container that holds the certificate and forwards to `next`:
#
#   COMPOSE_FILE=compose.yaml:compose.tls.yaml
#   TLS_SITE_ADDRESS=https://192.168.1.50
#   TLS_SNI=selfhealth.example.com
#   TLS_CERT_FILE=/path/to/server.crt
#   TLS_KEY_FILE=/path/to/server.key
#
# See the "TLS terminator" section at the bottom of this file. Use one of
# compose.proxy.yaml or compose.tls.yaml, never both - they both want :443.

# --- Site -------------------------------------------------------------------
# There is no bundled reverse proxy - this stack serves plain HTTP on
# HTTP_PORT (default 80), and that's genuinely fine: Claude Code's MCP client
# needs no TLS to connect. If you front this with your own reverse proxy for
# public HTTPS access, that's a supported pattern - see the docs site. If you
# want HTTPS but don't already run a proxy, compose.tls.yaml adds a minimal
# one - see the Compose section above.
HTTP_PORT=80

# The address you'll actually type into a browser to reach this instance.
# Quick start: leave as localhost. If you're deploying: your LAN IP or domain,
# e.g. http://192.168.1.50 or https://selfhealth.example.com.
SITE_URL=http://localhost
# Comma-separated host(s)/IP(s) Django will accept a request addressed to -
# include the host from SITE_URL (without the scheme). You do NOT need to add
# "127.0.0.1" or "django" here - those are internal compose-network hostnames
# Django always accepts regardless (see INTERNAL_HOSTS in
# backend/selfhealthos/settings/base.py); this is only for the address you
# actually reach the instance at.
DJANGO_ALLOWED_HOSTS=localhost
# Comma-separated origin(s) (with scheme) allowed to make unsafe (POST/PUT/
# DELETE) requests - same value as SITE_URL.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Browser-visible origin, must match SITE_URL. Used only as a last-resort
# fallback when a request arrives with no Host header at all.
NEXT_PUBLIC_SITE_URL=http://localhost

# --- Django -----------------------------------------------------------------
# If you're deploying: selfhealthos.settings.prod
DJANGO_SETTINGS_MODULE=selfhealthos.settings.dev
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-replace-me
# If you're deploying: false
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# --- Database ---------------------------------------------------------------
POSTGRES_DB=selfhealthos
POSTGRES_USER=selfhealthos
POSTGRES_PASSWORD=dev-only-insecure-password
DATABASE_URL=postgresql://selfhealthos:dev-only-insecure-password@db:5432/selfhealthos

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Wearable connections ----------------------------------------------------
# Encrypts Fitbit credentials at rest. Optional - falls back to
# DJANGO_SECRET_KEY if unset, at the cost of every connection needing to be
# re-authorised if you ever rotate that key. Generate the same way:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CREDENTIAL_ENCRYPTION_KEY=

# --- TLS terminator (only with compose.tls.yaml) ---------------------------
# Ignore this whole section unless COMPOSE_FILE names compose.tls.yaml.
#
# Addresses the terminator answers on, comma-separated. An IP is fine and is
# the point of this overlay: it works where DNS does not reach, which on a home
# LAN is usually the phone.
#TLS_SITE_ADDRESS=https://192.168.1.50, https://selfhealth.example.com
#
# A client connecting to a bare IP sends no SNI - that field carries a
# hostname, never an address - so there is no name to select a certificate by
# and the handshake fails. TLS_SNI names the certificate to fall back to.
#
# For a client to *validate* a certificate served over an IP, that IP must be
# in the cert's SANs. Check before you wonder why the phone still refuses it:
#   openssl x509 -in server.crt -noout -ext subjectAltName
#TLS_SNI=selfhealth.example.com
#
# Mounted as individual files, not as their directory: a cert directory
# usually also holds your CA's private key and every other host's key, and
# bind-mounting the folder would put all of them one bug away from being
# served. Absolute paths on the host.
#TLS_CERT_FILE=/path/to/server.crt
#TLS_KEY_FILE=/path/to/server.key
#
# Ports the terminator publishes. Defaults are 80 and 443. Set HTTP_PORT above
# to a loopback bind (127.0.0.1:8080) when using this, so the app is not also
# reachable unencrypted.
#TLS_HTTP_PORT=80
#TLS_HTTPS_PORT=443
